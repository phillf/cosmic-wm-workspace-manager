#!/usr/bin/env bash
set -Eeuo pipefail

readonly SCRIPT_NAME="${0##*/}"
readonly REPO_DIR="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." &&
    pwd -P
)"
readonly COMPOSE_FILE="$REPO_DIR/cosmic-compose.yaml"

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 2
}

usage() {
  cat <<'USAGE'
Usage:
  cosmic-compose validate
  cosmic-compose plan sysadmin WORKSPACE [CATEGORY]
  cosmic-compose profile sysadmin WORKSPACE CATEGORY
  cosmic-compose help

Commands:
  validate
      Validate cosmic-compose.yaml and any declared scoped profiles.

  plan sysadmin WORKSPACE [CATEGORY]
      Display declared COSMIC Compose membership for one sysadmin workspace.
      CATEGORY is optional. Supported values are:
      terminals, browsers, communications, git, media.
      When CATEGORY is omitted, all categories are displayed.

  profile sysadmin WORKSPACE CATEGORY
      Print the repository-relative scoped cold-start profile path declared for
      one sysadmin workspace/category pair. Fails if no scoped profile is
      declared for that category.

  help
      Show this help text.

Safety:
  This command is read-only. It does not render profiles, invoke cosmic-wm,
  launch or move windows, modify bootstrap state, or alter Git state.
USAGE
}

require_dependencies() {
  command -v python3 >/dev/null 2>&1 ||
    fail 'python3 is required but was not found on PATH.'

  python3 -c 'import yaml' >/dev/null 2>&1 ||
    fail 'PyYAML is required for cosmic-compose.'
}

run_python() {
  python3 - "$COMPOSE_FILE" "$@" <<'PYTHON'
import sys
from pathlib import Path

import yaml

manifest_path = Path(sys.argv[1])
arguments = sys.argv[2:]

REQUIRED_CATEGORIES = (
    "terminals",
    "browsers",
    "communications",
    "git",
    "media",
)
REQUIRED_CATEGORY_SET = set(REQUIRED_CATEGORIES)


def fail(message):
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(2)


def load_yaml(path, description):
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as error:
        fail(f"Cannot read {description} {path}: {error}")

    try:
        value = yaml.safe_load(raw)
    except yaml.YAMLError as error:
        fail(f"Invalid YAML in {description} {path}: {error}")

    return value


def require_mapping(value, description):
    if not isinstance(value, dict):
        fail(f"{description} must be a mapping.")
    return value


def require_app_list(profile, description):
    profile = require_mapping(profile, description)
    apps = profile.get("apps")

    if not isinstance(apps, list) or not apps:
        fail(f"{description}.apps must be a non-empty list.")

    for index, app in enumerate(apps):
        if not isinstance(app, dict):
            fail(f"{description}.apps[{index}] must be a mapping.")

    return apps


def canonical(value):
    return yaml.safe_dump(
        value,
        sort_keys=True,
        default_flow_style=False,
        allow_unicode=True,
    )


def load_profile(path, description):
    profile = load_yaml(path, description)
    return require_mapping(profile, description)


def validate_profile_apps(profile, description, workspace_number):
    apps = require_app_list(profile, description)

    for index, app in enumerate(apps):
        workspace = app.get("workspace")
        if workspace != workspace_number:
            fail(
                f"{description}.apps[{index}].workspace must be "
                f"{workspace_number}."
            )

        command = app.get("command")
        if not isinstance(command, str) or not command.strip():
            fail(
                f"{description}.apps[{index}].command must be a "
                "non-empty string."
            )

        match = require_mapping(
            app.get("match"),
            f"{description}.apps[{index}].match",
        )
        if not match:
            fail(f"{description}.apps[{index}].match must not be empty.")

        for key, value in match.items():
            if not isinstance(key, str) or not key.strip():
                fail(
                    f"{description}.apps[{index}].match has an invalid key."
                )
            if not isinstance(value, (str, int, float, bool)):
                fail(
                    f"{description}.apps[{index}].match.{key} must be "
                    "a scalar value."
                )

    return apps


def validate_scoped_profiles(
    definition,
    workspace,
    workspace_number,
    full_profile_path,
    applications,
):
    scoped_profiles = definition.get("scoped_profiles")
    if scoped_profiles is None:
        return

    scoped_profiles = require_mapping(
        scoped_profiles,
        f"Workspace {workspace!r}.scoped_profiles",
    )
    if not scoped_profiles:
        fail(f"Workspace {workspace!r}.scoped_profiles must not be empty.")

    full_profile = load_profile(
        full_profile_path,
        f"Full profile {full_profile_path}",
    )

    expected_full_name = f"sysadmin-ws{workspace_number}"
    if full_profile.get("name") != expected_full_name:
        fail(
            f"Full profile {full_profile_path} must have name "
            f"{expected_full_name!r}."
        )

    full_apps = validate_profile_apps(
        full_profile,
        f"Full profile {full_profile_path}",
        workspace_number,
    )
    full_app_keys = {canonical(app) for app in full_apps}

    declared_by_category = {
        category: []
        for category in REQUIRED_CATEGORIES
    }

    for name, application in applications.items():
        declared_by_category[application["category"]].append(
            (name, application)
        )

    for category, scoped_profile_path in scoped_profiles.items():
        if not isinstance(category, str) or category not in REQUIRED_CATEGORY_SET:
            fail(
                f"Workspace {workspace!r}.scoped_profiles has unsupported "
                f"category {category!r}."
            )

        if (
            not isinstance(scoped_profile_path, str)
            or not scoped_profile_path.strip()
        ):
            fail(
                f"Workspace {workspace!r}.scoped_profiles.{category} "
                "must be a non-empty profile path."
            )

        declared = declared_by_category[category]
        if not declared:
            fail(
                f"Workspace {workspace!r}.scoped_profiles.{category} is "
                "defined, but that category has no declared applications."
            )

        profile_path = manifest_path.parent / scoped_profile_path
        if not profile_path.is_file():
            fail(
                f"Workspace {workspace!r}.scoped_profiles.{category} "
                f"references missing profile: {scoped_profile_path}"
            )

        profile = load_profile(
            profile_path,
            f"Scoped profile {scoped_profile_path}",
        )

        expected_name = f"sysadmin-ws{workspace_number}-{category}"
        if profile.get("name") != expected_name:
            fail(
                f"Scoped profile {scoped_profile_path} must have name "
                f"{expected_name!r}."
            )

        scoped_apps = validate_profile_apps(
            profile,
            f"Scoped profile {scoped_profile_path}",
            workspace_number,
        )

        scoped_app_keys = [canonical(app) for app in scoped_apps]
        if len(scoped_app_keys) != len(set(scoped_app_keys)):
            fail(
                f"Scoped profile {scoped_profile_path} contains duplicate "
                "application mappings."
            )

        represented_names = set()

        for index, app in enumerate(scoped_apps):
            app_key = canonical(app)
            if app_key not in full_app_keys:
                fail(
                    f"Scoped profile {scoped_profile_path}.apps[{index}] "
                    "is not an exact application mapping from the full "
                    "workspace profile."
                )

            matches = [
                name
                for name, application in declared
                if application["match"] == app["match"]
            ]

            if not matches:
                fail(
                    f"Scoped profile {scoped_profile_path}.apps[{index}] "
                    f"does not belong to the {category!r} category."
                )

            if len(matches) > 1:
                fail(
                    f"Workspace {workspace!r} has ambiguous {category!r} "
                    f"match metadata for scoped app index {index}."
                )

            represented_names.add(matches[0])

        expected_names = {name for name, _ in declared}
        if represented_names != expected_names:
            missing = ", ".join(sorted(expected_names - represented_names))
            fail(
                f"Scoped profile {scoped_profile_path} does not cover every "
                f"declared {category!r} application: {missing}"
            )


def validate_manifest(manifest):
    version = manifest.get("version")
    if version != 1:
        fail("version must be the integer 1.")

    categories = require_mapping(manifest.get("categories"), "categories")
    missing = REQUIRED_CATEGORY_SET - set(categories)
    unknown = set(categories) - REQUIRED_CATEGORY_SET

    if missing:
        fail(
            "Missing required categories: "
            + ", ".join(
                category
                for category in REQUIRED_CATEGORIES
                if category in missing
            )
        )

    if unknown:
        fail("Unsupported categories: " + ", ".join(sorted(unknown)))

    for category in REQUIRED_CATEGORIES:
        definition = require_mapping(
            categories[category],
            f"Category {category!r}",
        )
        description = definition.get("description")

        if not isinstance(description, str) or not description.strip():
            fail(f"Category {category!r} requires a non-empty description.")

    workspaces = require_mapping(manifest.get("workspaces"), "workspaces")
    sysadmin = require_mapping(
        workspaces.get("sysadmin"),
        "workspaces.sysadmin",
    )

    if not sysadmin:
        fail("workspaces.sysadmin must define at least one workspace.")

    for workspace, definition in sysadmin.items():
        if not isinstance(workspace, str) or not workspace.isdigit():
            fail("sysadmin workspace keys must be numeric strings.")

        workspace_number = int(workspace)
        if not 1 <= workspace_number <= 6:
            fail(
                f"sysadmin workspace {workspace!r} is outside the supported "
                "range 1 through 6."
            )

        definition = require_mapping(
            definition,
            f"Workspace {workspace!r}",
        )

        profile = definition.get("profile")
        if not isinstance(profile, str) or not profile.strip():
            fail(f"Workspace {workspace!r} requires a non-empty profile path.")

        profile_path = manifest_path.parent / profile
        if not profile_path.is_file():
            fail(
                f"Workspace {workspace!r} references missing profile: {profile}"
            )

        applications = require_mapping(
            definition.get("applications"),
            f"Workspace {workspace!r}.applications",
        )

        if not applications:
            fail(f"Workspace {workspace!r} must define at least one application.")

        for name, application in applications.items():
            if not isinstance(name, str) or not name.strip():
                fail(f"Workspace {workspace!r} has an invalid application name.")

            application = require_mapping(
                application,
                f"Application {name!r}",
            )

            category = application.get("category")
            if category not in REQUIRED_CATEGORY_SET:
                fail(
                    f"Application {name!r} has unsupported category {category!r}."
                )

            match = require_mapping(
                application.get("match"),
                f"Application {name!r}.match",
            )

            if not match:
                fail(f"Application {name!r}.match must not be empty.")

            for key, value in match.items():
                if not isinstance(key, str) or not key.strip():
                    fail(f"Application {name!r}.match has an invalid key.")

                if not isinstance(value, (str, int, float, bool)):
                    fail(
                        f"Application {name!r}.match.{key} must be "
                        "a scalar value."
                    )

        validate_scoped_profiles(
            definition,
            workspace,
            workspace_number,
            profile_path,
            applications,
        )

    return sysadmin


manifest = load_yaml(manifest_path, "manifest")
if not isinstance(manifest, dict):
    fail("Manifest root must be a mapping.")

sysadmin_workspaces = validate_manifest(manifest)

if arguments == ["validate"]:
    print(f"PASS: validated {manifest_path.name}.")
    raise SystemExit(0)

if len(arguments) not in {3, 4} or arguments[:2] != ["plan", "sysadmin"]:
    if (
        len(arguments) == 4
        and arguments[:2] == ["profile", "sysadmin"]
    ):
        workspace = arguments[2]
        category = arguments[3]

        if workspace not in sysadmin_workspaces:
            fail(
                f"No sysadmin workspace definition exists for workspace "
                f"{workspace}."
            )

        if category not in REQUIRED_CATEGORY_SET:
            fail(
                "Unsupported category "
                f"{category!r}. Supported categories: "
                + ", ".join(REQUIRED_CATEGORIES)
                + "."
            )

        scoped_profiles = sysadmin_workspaces[workspace].get(
            "scoped_profiles",
            {},
        )
        scoped_profiles = require_mapping(
            scoped_profiles,
            f"Workspace {workspace!r}.scoped_profiles",
        )

        scoped_profile = scoped_profiles.get(category)
        if scoped_profile is None:
            fail(
                f"No scoped profile is declared for sysadmin workspace "
                f"{workspace} category {category!r}."
            )

        print(scoped_profile)
        raise SystemExit(0)

    fail("Invalid command. Run cosmic-compose help.")

workspace = arguments[2]
category = arguments[3] if len(arguments) == 4 else None

if workspace not in sysadmin_workspaces:
    fail(f"No sysadmin workspace definition exists for workspace {workspace}.")

if category is not None and category not in REQUIRED_CATEGORY_SET:
    fail(
        "Unsupported category "
        f"{category!r}. Supported categories: "
        + ", ".join(REQUIRED_CATEGORIES)
        + "."
    )

workspace_definition = sysadmin_workspaces[workspace]
applications = workspace_definition["applications"]

print(f"Profile: {workspace_definition['profile']}")
print(f"Scope: {category or 'all'}")
print("Applications:")

if category is not None:
    names = sorted(
        name
        for name, application in applications.items()
        if application["category"] == category
    )

    if names:
        for name in names:
            print(f"  - {name}")
    else:
        print("  none")

    raise SystemExit(0)

for declared_category in REQUIRED_CATEGORIES:
    names = sorted(
        name
        for name, application in applications.items()
        if application["category"] == declared_category
    )

    if names:
        print(f"  {declared_category}:")
        for name in names:
            print(f"    - {name}")
    else:
        print(f"  {declared_category}: none")
PYTHON
}

main() {
  case "${1:-}" in
    validate)
      [[ $# -eq 1 ]] || fail 'Usage: cosmic-compose validate'
      require_dependencies
      run_python validate
      ;;
    plan)
      require_dependencies
      run_python "$@"
      ;;
    profile)
      [[ $# -eq 4 ]] ||
        fail 'Usage: cosmic-compose profile sysadmin WORKSPACE CATEGORY'
      require_dependencies
      run_python "$@"
      ;;
    help|-h|--help)
      [[ $# -eq 1 ]] || fail 'Usage: cosmic-compose help'
      usage
      ;;
    '')
      usage >&2
      exit 2
      ;;
    *)
      fail "Unknown command: $1"
      ;;
  esac
}

main "$@"
